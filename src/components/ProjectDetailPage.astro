---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  useTranslations,
  normalizeLocale,
  pickLocalized,
  localizePath,
  projectPath,
  projectAlternates,
} from '../i18n/utils.js';

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
  total: number;
}

const { project, prev, next, total } = Astro.props;
const p = project.data;
const slug = project.id;

const locale = normalizeLocale(Astro.currentLocale);
const t = useTranslations(locale);
const L = (v) => pickLocalized(v, locale);

const paths = projectAlternates(slug);
const homePath = localizePath(locale, '/');
const pad = (n: number) => String(n).padStart(2, '0');

// Galeria: capa primeiro (se houver), depois o resto — o lightbox navega na mesma ordem.
const shots = [...(p.cover ? [p.cover] : []), ...p.gallery];
const galleryShots = shots.map((s, i) => ({ ...s, i })).slice(p.cover ? 1 : 0);
const desktopShots = galleryShots.filter(s => s.device === 'desktop');
const mobileShots = galleryShots.filter(s => s.device === 'mobile');
const coverIndex = 0;
// Projeto só mobile: a capa vira um trio de celulares (capa + as duas próximas telas mobile).
const coverPhones = p.cover?.device === 'mobile'
  ? [{ ...p.cover, i: 0 }, ...mobileShots.slice(0, 2)]
  : [];

const meta = [
  { label: t('detail.platforms'), value: L(p.type) },
  p.year && { label: t('detail.year'), value: p.year },
  p.status && { label: t('detail.status'), value: L(p.status) },
  p.role && { label: t('detail.role'), value: L(p.role) },
].filter(Boolean);

const lightboxData = shots.map(s => ({
  src: s.src,
  alt: L(s.alt),
  caption: s.caption ? L(s.caption) : '',
  device: s.device,
}));

const title = `${p.name} — ${L(p.tagline)} · Gustavo Zanatta`;
---

<Layout
  title={title}
  description={L(p.description)}
  paths={paths}
  ogImage={p.cover?.src}
  ogType="article"
>
  <nav id="detail-nav" aria-label={t('nav.ariaLabel')}>
    <a href={homePath} class="nav-logo">GZ</a>
    <div class="nav-right">
      <a href={`${homePath}#projetos`} class="nav-back">
        <span aria-hidden="true">←</span> {t('detail.back')}
      </a>
      <LanguageSwitcher paths={paths} />
    </div>
  </nav>

  <main class="detail">
    <!-- ─── Hero ─── -->
    <header class="detail-hero">
      <span class="hero-num" aria-hidden="true">{pad(p.order)}</span>
      <div class="container hero-inner">
        <p class="section-label hero-label">
          {t('projects.label')} <span class="hero-count">{pad(p.order)} / {pad(total)}</span>
        </p>

        <div class="hero-title-row">
          <div class="hero-icon" aria-hidden="true">
            <img src={p.icon} alt="" width="88" height="88" decoding="async" />
          </div>
          <div>
            <h1 class="hero-name">{p.name}</h1>
            <p class="hero-tagline">{L(p.tagline)}</p>
          </div>
        </div>

        <p class="hero-desc">{L(p.description)}</p>

        <dl class="hero-meta">
          {meta.map(m => (
            <div class="meta-item">
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>

        <div class="hero-actions">
          {p.link && (
            <a href={p.link} target="_blank" rel="noopener noreferrer" class="btn-primary">
              {t('detail.visit')} <span aria-hidden="true">↗</span>
            </a>
          )}
          {p.playStore && (
            <span class="store-pill" title={t('projects.playStoreTitle')}>
              <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M3.6 1.9a1.3 1.3 0 0 0-.5 1v18.2a1.3 1.3 0 0 0 .5 1l.1.1 10.2-10.1v-.2L3.7 1.8l-.1.1Zm13.5 6.6-2.6 2.6v.2l2.6 2.6.1-.1 3.1-1.7c.9-.5.9-1.4 0-1.9l-3.2-1.7ZM14.3 11l-9.8 9.8c.3.3.8.3 1.3 0l11.6-6.5L14.3 11Zm0 2L4.5 3.2c-.5-.3-1-.3-1.3 0l11.6 6.5L17.4 8l-3.1 5Z"
                />
              </svg>
              {t('projects.playStore')}
            </span>
          )}
        </div>
      </div>

      {coverPhones.length > 0 && (
        <div class="container hero-cover hero-phones reveal">
          {coverPhones.map((s, n) => (
            <button
              type="button"
              class={`shot shot-mobile phone-${n}`}
              data-shot={s.i}
              aria-label={`${t('detail.lightboxAria')}: ${L(s.alt)}`}
            >
              <img src={s.src} alt={L(s.alt)} loading="eager" decoding="async" />
            </button>
          ))}
          <div class="cover-glow" aria-hidden="true"></div>
        </div>
      )}

      {p.cover && p.cover.device === 'desktop' && (
        <div class="container hero-cover reveal">
          <button
            type="button"
            class="shot shot-desktop"
            data-shot={coverIndex}
            aria-label={`${t('detail.lightboxAria')}: ${L(p.cover.alt)}`}
          >
            <span class="frame-bar" aria-hidden="true"><i></i><i></i><i></i></span>
            <img src={p.cover.src} alt={L(p.cover.alt)} loading="eager" decoding="async" />
          </button>
          <div class="cover-glow" aria-hidden="true"></div>
        </div>
      )}
    </header>

    <!-- ─── Visão geral ─── -->
    {(p.summary.length > 0 || p.problem || p.audience) && (
      <section class="detail-section overview">
        <div class="container overview-grid">
          <div class="overview-main">
            <p class="section-label reveal">{t('detail.overviewLabel')}</p>
            {p.summary.map((para, i) => (
              <p class={`overview-text reveal reveal-delay-${Math.min(i + 1, 3)}`}>{L(para)}</p>
            ))}
          </div>
          <aside class="overview-aside">
            {p.problem && (
              <div class="aside-card reveal reveal-delay-1">
                <p class="aside-label">{t('detail.problemLabel')}</p>
                <p>{L(p.problem)}</p>
              </div>
            )}
            {p.audience && (
              <div class="aside-card reveal reveal-delay-2">
                <p class="aside-label">{t('detail.audienceLabel')}</p>
                <p>{L(p.audience)}</p>
              </div>
            )}
          </aside>
        </div>
      </section>
    )}

    <!-- ─── Funcionalidades ─── -->
    {p.features.length > 0 && (
      <section class="detail-section">
        <div class="container">
          <p class="section-label reveal">{t('detail.featuresLabel')}</p>
          <h2 class="section-heading reveal" set:html={t('detail.featuresHeadingHtml')} />
          <ol class="feature-grid">
            {p.features.map((f, i) => (
              <li class={`feature-card reveal reveal-delay-${i % 3}`}>
                <span class="feature-num" aria-hidden="true">{pad(i + 1)}</span>
                <h3 class="feature-title">{L(f.title)}</h3>
                <p class="feature-text">{L(f.text)}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- ─── Galeria ─── -->
    {(desktopShots.length > 0 || mobileShots.length > 0) && (
      <section class="detail-section gallery">
        <div class="container">
          <p class="section-label reveal">{t('detail.galleryLabel')}</p>
          <h2 class="section-heading reveal" set:html={t('detail.galleryHeadingHtml')} />

          {desktopShots.length > 0 && (
            <div class="gallery-desktop">
              {desktopShots.map((s, i) => (
                <figure class={`gallery-item reveal reveal-delay-${i % 2}`}>
                  <button
                    type="button"
                    class="shot shot-desktop"
                    data-shot={s.i}
                    aria-label={`${t('detail.lightboxAria')}: ${L(s.alt)}`}
                  >
                    <span class="frame-bar" aria-hidden="true"><i></i><i></i><i></i></span>
                    <img src={s.src} alt={L(s.alt)} loading="lazy" decoding="async" />
                  </button>
                  {s.caption && <figcaption>{L(s.caption)}</figcaption>}
                </figure>
              ))}
            </div>
          )}

          {mobileShots.length > 0 && (
            <div class="gallery-mobile">
              {mobileShots.map((s, i) => (
                <figure class={`gallery-item reveal reveal-delay-${i % 4}`}>
                  <button
                    type="button"
                    class="shot shot-mobile"
                    data-shot={s.i}
                    aria-label={`${t('detail.lightboxAria')}: ${L(s.alt)}`}
                  >
                    <img src={s.src} alt={L(s.alt)} loading="lazy" decoding="async" />
                  </button>
                  {s.caption && <figcaption>{L(s.caption)}</figcaption>}
                </figure>
              ))}
            </div>
          )}

          <p class="gallery-note">{t('detail.galleryNote')}</p>
        </div>
      </section>
    )}

    <!-- ─── Stack ─── -->
    <section class="detail-section">
      <div class="container">
        <p class="section-label reveal">{t('detail.stackLabel')}</p>
        <h2 class="section-heading reveal" set:html={t('detail.stackHeadingHtml')} />
        {p.stackLayers.length > 0 ? (
          <dl class="stack-layers">
            {p.stackLayers.map((layer, i) => (
              <div class={`stack-row reveal reveal-delay-${Math.min(i, 3)}`}>
                <dt>{t(`detail.layer.${layer.layer}`)}</dt>
                <dd>
                  {layer.items.map(item => <span class="stack-tag">{item}</span>)}
                </dd>
              </div>
            ))}
          </dl>
        ) : (
          <div class="stack-flat reveal">
            {p.stack.map(item => <span class="stack-tag">{item}</span>)}
          </div>
        )}
      </div>
    </section>

    <!-- ─── Desafios técnicos ─── -->
    {p.challenges.length > 0 && (
      <section class="detail-section">
        <div class="container">
          <p class="section-label reveal">{t('detail.challengesLabel')}</p>
          <h2 class="section-heading reveal" set:html={t('detail.challengesHeadingHtml')} />
          <ol class="challenge-list">
            {p.challenges.map((c, i) => (
              <li class="challenge reveal">
                <span class="challenge-num" aria-hidden="true">{pad(i + 1)}</span>
                <h3 class="challenge-title">{L(c.title)}</h3>
                <p class="challenge-text">{L(c.text)}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- ─── Anterior / próximo ─── -->
    <nav class="pager" aria-label={t('projects.label')}>
      <a href={projectPath(locale, prev.id)} class="pager-link pager-prev">
        <span class="pager-dir"><span aria-hidden="true">←</span> {t('detail.prev')}</span>
        <span class="pager-name">{prev.data.name}</span>
      </a>
      <a href={projectPath(locale, next.id)} class="pager-link pager-next">
        <span class="pager-dir">{t('detail.next')} <span aria-hidden="true">→</span></span>
        <span class="pager-name">{next.data.name}</span>
      </a>
    </nav>

    <!-- ─── CTA ─── -->
    <section class="detail-cta">
      <div class="container cta-inner">
        <h2 class="cta-heading reveal" set:html={t('detail.ctaHeadingHtml')} />
        <p class="cta-body reveal reveal-delay-1">{t('detail.ctaBody')}</p>
        <a href={`${homePath}#contato`} class="btn-primary reveal reveal-delay-2">
          {t('detail.ctaButton')} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="detail-footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} Gustavo Felipe Zanatta</span>
      <span>{t('footer.built')}</span>
    </div>
  </footer>

  {shots.length > 0 && (
    <dialog class="lightbox" aria-label={t('detail.lightboxAria')}>
      <button type="button" class="lb-close" aria-label={t('detail.lightboxClose')}>✕</button>
      {shots.length > 1 && (
        <button type="button" class="lb-nav lb-prev" aria-label={t('detail.lightboxPrev')}>←</button>
      )}
      <figure class="lb-figure">
        <img class="lb-img" src="" alt="" />
        <figcaption class="lb-caption"></figcaption>
      </figure>
      {shots.length > 1 && (
        <button type="button" class="lb-nav lb-next" aria-label={t('detail.lightboxNext')}>→</button>
      )}
      <script type="application/json" class="lb-data" set:html={JSON.stringify(lightboxData)} />
    </dialog>
  )}
</Layout>

<style>
  /* ─── Nav ─── */
  #detail-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 200;
    padding: 1.4rem clamp(1rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, padding 0.4s ease;
  }
  #detail-nav.scrolled {
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(14px);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    transition: opacity 0.3s;
  }
  .nav-logo:hover { opacity: 0.65; }
  .nav-right {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .nav-back {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.3s;
  }
  .nav-back:hover { color: var(--text); }

  /* ─── Hero ─── */
  .detail-hero {
    position: relative;
    padding: clamp(7.5rem, 16vw, 11rem) 0 clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }
  .detail-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 80% 10%, rgba(0, 212, 255, 0.09), transparent 70%),
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px) 0 0 / 100% 64px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
    pointer-events: none;
  }
  .hero-num {
    position: absolute;
    top: clamp(4rem, 8vw, 6rem);
    right: clamp(-1rem, 2vw, 3rem);
    font-family: var(--font-display);
    font-size: clamp(10rem, 30vw, 24rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px rgba(0, 212, 255, 0.14);
    user-select: none;
    pointer-events: none;
  }
  .hero-inner { position: relative; }
  .hero-count {
    color: var(--text-dim);
    margin-left: 0.8rem;
    letter-spacing: 0.12em;
  }
  .hero-title-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
    margin-bottom: 1.75rem;
  }
  .hero-icon {
    flex-shrink: 0;
    width: clamp(64px, 9vw, 88px);
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-hover);
    box-shadow: 0 0 40px var(--accent-dim);
  }
  .hero-icon img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-name {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 7vw, 5.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero-tagline {
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    font-weight: 500;
    color: var(--accent);
    margin-top: 0.5rem;
  }
  .hero-desc {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    margin-bottom: 2.5rem;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem clamp(2rem, 5vw, 4rem);
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.25rem;
  }
  .meta-item dt {
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.2rem;
  }
  .meta-item dd {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--text);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .store-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.55rem 1rem;
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: 2rem;
    background: var(--accent-dim);
  }

  .hero-cover {
    position: relative;
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .hero-phones {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.75rem, 3vw, 2.5rem);
  }
  .hero-phones .shot-mobile { width: min(30%, 280px); }
  .hero-phones .phone-0 { order: 2; width: min(34%, 310px); z-index: 1; }
  .hero-phones .phone-1 { order: 1; transform: translateY(-1.5rem) rotate(-3deg); }
  .hero-phones .phone-2 { order: 3; transform: translateY(-1.5rem) rotate(3deg); }
  .hero-phones .phone-1:hover { transform: translateY(-2rem) rotate(-3deg); }
  .hero-phones .phone-2:hover { transform: translateY(-2rem) rotate(3deg); }

  .cover-glow {
    position: absolute;
    inset: 10% 5% -8% 5%;
    background: radial-gradient(closest-side, rgba(0, 212, 255, 0.16), transparent);
    filter: blur(40px);
    z-index: -1;
  }

  /* ─── Frames ─── */
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: none;
    position: relative;
    overflow: hidden;
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.4s;
  }
  .shot img {
    display: block;
    width: 100%;
    object-fit: cover;
    object-position: top center;
    background: var(--surface);
  }
  .shot:hover { transform: translateY(-4px); }
  .shot:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .shot-desktop {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #0f0f0f;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.9);
  }
  .shot-desktop:hover { border-color: var(--border-hover); box-shadow: 0 30px 80px -30px rgba(0, 212, 255, 0.25); }
  .shot-desktop img { aspect-ratio: 16 / 10; }
  .frame-bar {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }
  .frame-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
  }

  .shot-mobile {
    border: 7px solid #1a1a1a;
    border-radius: 34px;
    background: #1a1a1a;
    box-shadow: 0 0 0 1px var(--border), 0 30px 60px -25px rgba(0, 0, 0, 0.9);
  }
  .shot-mobile:hover { box-shadow: 0 0 0 1px var(--border-hover), 0 30px 60px -25px rgba(0, 212, 255, 0.25); }
  .shot-mobile img { aspect-ratio: 390 / 844; border-radius: 27px; }

  /* ─── Sections ─── */
  .detail-section {
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: 1px solid var(--border);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .overview-text {
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    color: var(--text);
    opacity: 0.86;
    margin-bottom: 1.4rem;
    max-width: 60ch;
  }
  .overview-aside { display: grid; gap: 1rem; }
  .aside-card {
    padding: 1.6rem 1.75rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    background: rgba(255, 255, 255, 0.015);
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .aside-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .feature-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .feature-card {
    background: var(--bg);
    padding: 2rem 1.9rem 2.2rem;
    transition: background 0.4s;
  }
  .feature-card:hover { background: rgba(0, 212, 255, 0.025); }
  .feature-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--accent);
    opacity: 0.6;
  }
  .feature-title {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 600;
    margin: 0.6rem 0 0.55rem;
  }
  .feature-text { color: var(--text-muted); font-size: 0.93rem; }

  .gallery-desktop {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }
  .gallery-mobile {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 210px), 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .gallery-item figcaption {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.9rem;
  }
  .gallery-note {
    margin-top: 2.5rem;
    font-size: 0.78rem;
    color: var(--text-dim);
    font-style: italic;
  }

  .stack-layers { border-top: 1px solid var(--border); }
  .stack-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .stack-row dt {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .stack-row dd, .stack-flat { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .stack-tag {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
    color: var(--text);
    background: rgba(255, 255, 255, 0.02);
  }

  .challenge-list { list-style: none; border-top: 1px solid var(--border); }
  .challenge {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    grid-template-areas: 'num title' 'num text';
    column-gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }
  .challenge-num {
    grid-area: num;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--text-dim);
    transition: color 0.3s;
  }
  .challenge:hover .challenge-num { color: var(--accent); }
  .challenge-title {
    grid-area: title;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .challenge-text { grid-area: text; color: var(--text-muted); max-width: 70ch; }

  /* ─── Pager ─── */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 4rem);
    transition: background 0.4s;
  }
  .pager-link:hover { background: rgba(0, 212, 255, 0.025); }
  .pager-next { text-align: right; border-left: 1px solid var(--border); }
  .pager-dir {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .pager-name {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: color 0.3s;
  }
  .pager-link:hover .pager-name { color: var(--accent); }

  /* ─── CTA + footer ─── */
  .detail-cta {
    padding: clamp(5rem, 11vw, 8rem) 0;
    text-align: center;
  }
  .cta-inner { display: flex; flex-direction: column; align-items: center; }
  .cta-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .cta-body { color: var(--text-muted); max-width: 52ch; margin-bottom: 2.25rem; }

  .detail-footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 0;
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .footer-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  /* ─── Lightbox ─── */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(10px);
    color: var(--text);
    cursor: none;
  }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; gap: 1rem; }
  .lightbox::backdrop { background: transparent; }
  .lb-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    max-height: 100%;
    min-width: 0;
  }
  .lb-img {
    max-width: min(1400px, 100%);
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .lb-img.is-mobile { border-radius: 24px; }
  .lb-caption { font-size: 0.88rem; color: var(--text-muted); text-align: center; }
  .lb-close, .lb-nav {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 1.1rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    flex-shrink: 0;
    cursor: none;
    transition: border-color 0.3s, color 0.3s;
  }
  .lb-close:hover, .lb-nav:hover { border-color: var(--accent); color: var(--accent); }
  .lb-close { position: absolute; top: 1.25rem; right: 1.25rem; }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .overview-grid { grid-template-columns: 1fr; }
    .gallery-desktop { grid-template-columns: 1fr; }
    .stack-row { grid-template-columns: 1fr; gap: 0.75rem; }
  }
  @media (max-width: 600px) {
    .nav-back { font-size: 0; }
    .nav-back span { font-size: 1.1rem; }
    .hero-title-row { align-items: flex-start; }
    .challenge { grid-template-columns: 3rem 1fr; column-gap: 1rem; }
    .challenge-num { font-size: 1.9rem; }
    .pager-name { font-size: 1.1rem; }
    .lb-nav { position: absolute; bottom: 1.25rem; }
    .lb-prev { left: calc(50% - 3.5rem); }
    .lb-next { right: calc(50% - 3.5rem); }
    .lb-img { max-height: calc(100dvh - 11rem); }
  }
  @media (pointer: coarse) {
    .shot, .lightbox, .lb-close, .lb-nav { cursor: pointer; }
  }
</style>

<script>
  // Nav: fundo ao rolar
  const nav = document.getElementById('detail-nav') as HTMLElement;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Reveal ao entrar na viewport
  const revealObserver = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        revealObserver.unobserve(e.target);
      }
    }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

  // Lightbox
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dialog) {
    type Shot = { src: string; alt: string; caption: string; device: string };
    const shots: Shot[] = JSON.parse(dialog.querySelector('.lb-data')!.textContent || '[]');
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + shots.length) % shots.length;
      const s = shots[current];
      img.src = s.src;
      img.alt = s.alt;
      img.classList.toggle('is-mobile', s.device === 'mobile');
      caption.textContent = s.caption || s.alt;
    };

    document.querySelectorAll<HTMLElement>('[data-shot]').forEach(btn => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.shot));
        dialog.showModal();
      });
    });

    dialog.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lb-next')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>
