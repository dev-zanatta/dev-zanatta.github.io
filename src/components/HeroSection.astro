---
---

<!-- Custom cursor -->
<div class="cursor" id="cursor" aria-hidden="true"></div>
<div class="cursor-follower" id="cursor-follower" aria-hidden="true"></div>

<!-- Navigation -->
<nav id="main-nav" aria-label="Navegação principal">
  <a href="#hero" class="nav-logo">GZ</a>
  <ul class="nav-links">
    <li><a href="#sobre">Sobre</a></li>
    <li><a href="#projetos">Projetos</a></li>
    <li><a href="#stack">Stack</a></li>
    <li><a href="#contato">Contato</a></li>
  </ul>
  <div class="nav-progress" aria-hidden="true"></div>
</nav>

<!-- Hero section -->
<section id="hero">
  <!-- Three.js canvas background -->
  <div id="hero-canvas-wrapper" aria-hidden="true">
    <canvas id="hero-canvas"></canvas>
  </div>

  <!-- Left gradient overlay so text is readable over the 3D scene -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Hero content -->
  <div class="hero-content container">
    <p class="hero-eyebrow">Desenvolvedor Full Stack</p>
    <h1 class="hero-name">Gustavo Zanatta</h1>
    <p class="hero-subtitle">
      Transformando ideias em <span class="accent">sistemas reais</span> —
      web, mobile e desktop com Vue&nbsp;3, Laravel e AWS
    </p>
    <div class="hero-tags" aria-label="Tecnologias principais">
      <span>Vue 3</span>
      <span>Laravel</span>
      <span>PostgreSQL</span>
      <span>Quasar</span>
      <span>AWS</span>
      <span>Capacitor</span>
      <span>Tauri</span>
    </div>
    <div class="hero-ctas">
      <a href="#projetos" class="btn-primary">Ver Projetos</a>
      <a href="https://github.com/dev-zanatta" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        GitHub
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <span>scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  /* ─── Nav ─── */
  #main-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 1.4rem clamp(1.5rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, padding 0.4s ease;
  }
  #main-nav.scrolled {
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(14px);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    transition: opacity 0.3s;
  }
  .nav-logo:hover { opacity: 0.65; }

  .nav-links {
    display: flex;
    list-style: none;
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .nav-links a {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    position: relative;
    transition: color 0.3s;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { width: 100%; }

  /* Scroll progress bar (thin line at bottom of nav) */
  .nav-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), rgba(0,212,255,0.3));
  }

  /* ─── Hero section ─── */
  #hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 620px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #hero-canvas-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Gradient: left side solid (text readable) → right side reveals 3D */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      110deg,
      var(--bg) 25%,
      rgba(8, 8, 8, 0.75) 55%,
      rgba(8, 8, 8, 0.2) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ─── Hero content ─── */
  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 5rem;
  }

  .hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 10.5rem);
    line-height: 0.88;
    letter-spacing: 0.01em;
    color: var(--text);
    margin-bottom: 2rem;
    /* perspective for SplitText 3D rotation */
    perspective: 600px;
  }

  .hero-subtitle {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 46ch;
    margin-bottom: 2rem;
    line-height: 1.65;
  }
  .hero-subtitle .accent {
    color: var(--text);
    font-weight: 500;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2.75rem;
  }
  .hero-tags span {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
    color: var(--text-muted);
    background: rgba(255,255,255,0.02);
    transition: border-color 0.3s, color 0.3s, background 0.3s;
    cursor: default;
  }
  .hero-tags span:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* ─── Scroll indicator ─── */
  .scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .scroll-indicator span {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scrollPulse 2.2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.25; transform: scaleY(0.7); }
    50%       { opacity: 1;    transform: scaleY(1);   }
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .nav-links { display: none; }
    #hero { height: 100dvh; }
    .hero-name { font-size: clamp(3.5rem, 16vw, 5rem); }
    .hero-subtitle { font-size: 1rem; }
  }
</style>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // ══════════════════════════════════════════
  //  THREE.JS — HERO 3D SCENE
  // ══════════════════════════════════════════
  const canvas  = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const wrapper = document.getElementById('hero-canvas-wrapper') as HTMLElement;

  const scene = new THREE.Scene();
  let W = window.innerWidth;
  let H = window.innerHeight;

  const camera = new THREE.PerspectiveCamera(58, W / H, 0.1, 1000);
  camera.position.set(2, 0, 5.5);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setSize(W, H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // Geometry
  const geometry = new THREE.TorusKnotGeometry(1.35, 0.38, 220, 32);

  // Solid inner mesh (very dark teal)
  const solidMesh = new THREE.Mesh(
    geometry,
    new THREE.MeshStandardMaterial({ color: 0x041520, roughness: 0.6, metalness: 0.4 })
  );
  scene.add(solidMesh);

  // Wireframe mesh (cyan)
  const wireMesh = new THREE.Mesh(
    geometry,
    new THREE.MeshBasicMaterial({ color: 0x00d4ff, wireframe: true, transparent: true, opacity: 0.52 })
  );
  scene.add(wireMesh);

  // Lights
  scene.add(new THREE.AmbientLight(0xffffff, 0.15));

  const light1 = new THREE.PointLight(0x00d4ff, 8, 22);
  light1.position.set(4, 3, 4);
  scene.add(light1);

  const light2 = new THREE.PointLight(0x0033ff, 4, 16);
  light2.position.set(-4, -2, 2);
  scene.add(light2);

  // Position shape to right side
  solidMesh.position.x = 2.5;
  wireMesh.position.x  = 2.5;

  // Mouse tracking for subtle influence
  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;

  window.addEventListener('mousemove', (e) => {
    targetX = (e.clientX / W - 0.5) * 1.4;
    targetY = (e.clientY / H - 0.5) * 0.9;
  });

  // Render loop
  function animate() {
    requestAnimationFrame(animate);
    const t = performance.now() * 0.001;

    solidMesh.rotation.x = t * 0.22;
    solidMesh.rotation.y = t * 0.38;

    currentX += (targetX - currentX) * 0.035;
    currentY += (targetY - currentY) * 0.035;
    solidMesh.rotation.x += currentY * 0.45;
    solidMesh.rotation.y += currentX * 0.45;

    wireMesh.rotation.copy(solidMesh.rotation);

    renderer.render(scene, camera);
  }
  animate();

  // Scroll: camera pulls back + canvas fades out
  gsap.to(camera.position, {
    z: 11,
    ease: 'none',
    scrollTrigger: {
      trigger: '#hero',
      start: 'top top',
      end: 'bottom top',
      scrub: 2,
    },
  });

  gsap.to(wrapper, {
    opacity: 0,
    scrollTrigger: {
      trigger: '#hero',
      start: '45% top',
      end: '90% top',
      scrub: 1,
    },
  });

  // Resize
  window.addEventListener('resize', () => {
    W = window.innerWidth;
    H = window.innerHeight;
    camera.aspect = W / H;
    camera.updateProjectionMatrix();
    renderer.setSize(W, H);
    ScrollTrigger.refresh();
  });

  // ══════════════════════════════════════════
  //  NAV — scroll behavior & progress bar
  // ══════════════════════════════════════════
  const nav      = document.getElementById('main-nav') as HTMLElement;
  const progress = nav.querySelector('.nav-progress') as HTMLElement;

  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 60);
    const total = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = ((window.scrollY / total) * 100) + '%';
  }, { passive: true });

  // ══════════════════════════════════════════
  //  CUSTOM CURSOR
  // ══════════════════════════════════════════
  const cursor   = document.getElementById('cursor') as HTMLElement;
  const follower = document.getElementById('cursor-follower') as HTMLElement;

  const moveX   = gsap.quickTo(cursor,   'x', { duration: 0.08 });
  const moveY   = gsap.quickTo(cursor,   'y', { duration: 0.08 });
  const followX = gsap.quickTo(follower, 'x', { duration: 0.38, ease: 'power3' });
  const followY = gsap.quickTo(follower, 'y', { duration: 0.38, ease: 'power3' });

  window.addEventListener('mousemove', (e) => {
    moveX(e.clientX); moveY(e.clientY);
    followX(e.clientX); followY(e.clientY);
  }, { passive: true });

  document.querySelectorAll<HTMLElement>('a, button').forEach(el => {
    el.addEventListener('mouseenter', () =>
      gsap.to(follower, { scale: 2.2, opacity: 0.18, duration: 0.3 }));
    el.addEventListener('mouseleave', () =>
      gsap.to(follower, { scale: 1, opacity: 0.45, duration: 0.3 }));
  });

  // ══════════════════════════════════════════
  //  HERO INTRO ANIMATION
  // ══════════════════════════════════════════
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    // Initial hidden states
    gsap.set(wrapper,                   { opacity: 0 });
    gsap.set('#main-nav',               { opacity: 0, y: -24 });
    gsap.set('.hero-eyebrow',           { opacity: 0 });
    gsap.set('.hero-subtitle',          { opacity: 0, y: 18 });
    gsap.set('.hero-tags',              { opacity: 0, y: 16 });
    gsap.set('.hero-ctas',              { opacity: 0, y: 16 });
    gsap.set('.scroll-indicator',       { opacity: 0 });

    // SplitText on hero name
    const split = new SplitText('.hero-name', { type: 'chars' });
    gsap.set(split.chars, { opacity: 0, y: 70, rotationX: -85, transformOrigin: '50% 50% -30px' });

    const tl = gsap.timeline({ delay: 0.25 });

    tl.to(wrapper, { opacity: 1, duration: 1.6, ease: 'power2.out' });

    tl.to(split.chars, {
      opacity: 1,
      y: 0,
      rotationX: 0,
      stagger: 0.038,
      duration: 0.72,
      ease: 'back.out(1.8)',
    }, '-=1.0');

    tl.to('.hero-eyebrow',     { opacity: 1, duration: 0.5, ease: 'power3.out' }, '-=0.5');
    tl.to('.hero-subtitle',    { opacity: 1, y: 0, duration: 0.65, ease: 'power3.out' }, '-=0.35');
    tl.to('.hero-tags',        { opacity: 1, y: 0, duration: 0.6,  ease: 'power3.out' }, '-=0.45');
    tl.to('.hero-ctas',        { opacity: 1, y: 0, duration: 0.6,  ease: 'power3.out' }, '-=0.45');
    tl.to('.scroll-indicator', { opacity: 1, duration: 0.6 }, '-=0.2');
    tl.to('#main-nav',         { opacity: 1, y: 0, duration: 0.55, ease: 'power3.out' }, '<-1.2');
  }

  // ══════════════════════════════════════════
  //  SCROLL REVEAL (IntersectionObserver)
  // ══════════════════════════════════════════
  const revealObserver = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        revealObserver.unobserve(e.target);
      }
    }),
    { threshold: 0.14 }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
</script>
