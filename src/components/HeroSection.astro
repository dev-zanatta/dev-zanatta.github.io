---
---

<div class="cursor" id="cursor" aria-hidden="true"></div>
<div class="cursor-follower" id="cursor-follower" aria-hidden="true"></div>

<nav id="main-nav" aria-label="Navegação principal">
  <a href="#hero" class="nav-logo">GZ</a>
  <ul class="nav-links">
    <li><a href="#sobre">Sobre</a></li>
    <li><a href="#stack">Stack</a></li>
    <li><a href="#projetos">Projetos</a></li>
    <li><a href="#contato">Contato</a></li>
  </ul>
  <div class="nav-progress" aria-hidden="true"></div>
</nav>

<section id="hero">
  <div id="hero-canvas-wrapper" aria-hidden="true">
    <canvas id="hero-canvas"></canvas>
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content container">
    <p class="hero-eyebrow">Desenvolvedor Full Stack</p>
    <h1 class="hero-name">Gustavo</h1>
    <h1 class="hero-name">Felipe</h1>
    <h1 class="hero-name">Zanatta</h1>
    <p class="hero-subtitle">
      Transformando ideias em <span class="accent">sistemas reais</span> —
      web, mobile e desktop com Vue 3, Laravel e Node
    </p>
    <div class="hero-tags" aria-label="Tecnologias principais">
      <span>Vue 3</span>
      <span>Laravel</span>
      <span>PostgreSQL</span>
      <span>Quasar</span>
      <span>Node.js</span>
      <span>Capacitor</span>
    </div>
    <div class="hero-ctas">
      <a href="#projetos" class="btn-primary">Ver Projetos</a>
      <a href="https://github.com/dev-zanatta" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        GitHub
      </a>
    </div>
  </div>

  <div class="scroll-indicator" aria-hidden="true">
    <span>scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  #main-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 1.4rem clamp(1.5rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, padding 0.4s ease;
  }
  #main-nav.scrolled {
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(14px);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    transition: opacity 0.3s;
  }
  .nav-logo:hover { opacity: 0.65; }

  .nav-links {
    display: flex;
    list-style: none;
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .nav-links a {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    position: relative;
    transition: color 0.3s;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { width: 100%; }

  .nav-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), rgba(0,212,255,0.3));
  }

  #hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 620px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #hero-canvas-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      110deg,
      var(--bg) 25%,
      rgba(8, 8, 8, 0.75) 55%,
      rgba(8, 8, 8, 0.2) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 5rem;
  }

  .hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 10.5rem);
    line-height: 0.88;
    letter-spacing: 0.01em;
    color: var(--text);
    margin-bottom: 2rem;
    perspective: 600px;
  }

  .hero-subtitle {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 46ch;
    margin-bottom: 2rem;
    line-height: 1.65;
  }
  .hero-subtitle .accent {
    color: var(--text);
    font-weight: 500;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2.75rem;
  }
  .hero-tags span {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
    color: var(--text-muted);
    background: rgba(255,255,255,0.02);
    transition: border-color 0.3s, color 0.3s, background 0.3s;
    cursor: default;
  }
  .hero-tags span:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .scroll-indicator span {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scrollPulse 2.2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.25; transform: scaleY(0.7); }
    50%       { opacity: 1;    transform: scaleY(1);   }
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    #hero { height: 100dvh; }
    .hero-name { font-size: clamp(3.5rem, 16vw, 5rem); }
    .hero-subtitle { font-size: 1rem; }
  }
</style>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  const canvas  = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const wrapper = document.getElementById('hero-canvas-wrapper') as HTMLElement;

  const scene = new THREE.Scene();
  let W = window.innerWidth;
  let H = window.innerHeight;

  const camera = new THREE.PerspectiveCamera(55, W / H, 0.1, 1000);
  camera.position.set(0, 0, 6.5);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setSize(W, H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // Materials — dark metallic body + cyan wireframe overlay
  const solidMat = new THREE.MeshStandardMaterial({ color: 0x051a26, roughness: 0.4, metalness: 0.7 });
  const wireMat  = new THREE.MeshBasicMaterial({ color: 0x00d4ff, wireframe: true, transparent: true, opacity: 0.48 });

  // Build a gear profile (rectangular teeth) with a centre axle hole
  function buildGearShape(teeth: number, innerR: number, outerR: number): THREE.Shape {
    const shape = new THREE.Shape();
    const pitch = (Math.PI * 2) / teeth;
    const tw    = pitch * 0.21; // half-width of each tooth, in radians

    for (let i = 0; i < teeth; i++) {
      const c = i * pitch;
      const pts: [number, number][] = [
        [Math.cos(c - tw) * innerR,         Math.sin(c - tw) * innerR],
        [Math.cos(c - tw * 0.42) * outerR,  Math.sin(c - tw * 0.42) * outerR],
        [Math.cos(c + tw * 0.42) * outerR,  Math.sin(c + tw * 0.42) * outerR],
        [Math.cos(c + tw) * innerR,         Math.sin(c + tw) * innerR],
        [Math.cos(c + pitch - tw) * innerR, Math.sin(c + pitch - tw) * innerR],
      ];
      if (i === 0) shape.moveTo(...pts[0]);
      else         shape.lineTo(...pts[0]);
      for (let j = 1; j < pts.length; j++) shape.lineTo(...pts[j]);
    }
    shape.closePath();

    // Axle hole (wound CW so it becomes a cutout)
    const hole = new THREE.Path();
    const hr = innerR * 0.38;
    const hs = 28;
    for (let k = hs; k >= 0; k--) {
      const a = (k / hs) * Math.PI * 2;
      if (k === hs) hole.moveTo(Math.cos(a) * hr, Math.sin(a) * hr);
      else          hole.lineTo(Math.cos(a) * hr, Math.sin(a) * hr);
    }
    shape.holes.push(hole);
    return shape;
  }

  // Shared module — every gear uses the same tooth pitch so they can mesh.
  // Tuned so the 22-tooth main gear has pitch radius ≈ 1.05.
  const MODULE = (2 * 1.05) / 22;

  function makeGear(teeth: number, pitchR: number, depth: number): THREE.Group {
    const tipR  = pitchR + MODULE;          // addendum  = 1·module
    const rootR = pitchR - 1.25 * MODULE;   // dedendum  = 1.25·module → 0.25·module clearance
    const geo = new THREE.ExtrudeGeometry(
      buildGearShape(teeth, rootR, tipR),
      { depth, bevelEnabled: true, bevelThickness: 0.025, bevelSize: 0.018, bevelSegments: 2 }
    );
    geo.center();
    const g = new THREE.Group();
    g.add(new THREE.Mesh(geo, solidMat), new THREE.Mesh(geo, wireMat));
    return g;
  }

  // Gear train. Each non-root gear meshes with its `parent`, sitting at angle
  // `beta` (direction from parent's centre to this gear's centre).
  //   • pitch radius  = MODULE · teeth / 2   (constant module → teeth fit)
  //   • centre dist   = rParent + rChild      (pitch circles tangent, clearance
  //                                            built into addendum/dedendum)
  //   • ratio         = -(Nparent / Nchild) · ratioParent  (meshing speed)
  //   • init phase     solved so a tooth of one sits in the gap of the other
  type GearDef = {
    teeth: number; ratio: number; parent: number | null; beta: number;
    r: number; x: number; y: number; init: number;
  };

  const gearDefs: GearDef[] = [
    { teeth: 22, ratio: 1,         parent: null, beta: 0,            r: 0, x: 0, y: 0, init: 0 }, // A – main
    { teeth: 11, ratio: -2,        parent: 0,    beta: 0,            r: 0, x: 0, y: 0, init: 0 }, // B – right of A
    { teeth:  7, ratio: 22 / 7,    parent: 1,    beta: -Math.PI / 2, r: 0, x: 0, y: 0, init: 0 }, // C – below B
    { teeth: 14, ratio: -22 / 14,  parent: 0,    beta:  Math.PI / 2, r: 0, x: 0, y: 0, init: 0 }, // D – above A
  ];

  gearDefs.forEach((g) => {
    g.r = (MODULE * g.teeth) / 2;
    if (g.parent === null) return;
    const p = gearDefs[g.parent];
    const dist = p.r + g.r;
    g.x = p.x + Math.cos(g.beta) * dist;
    g.y = p.y + Math.sin(g.beta) * dist;
    // Meshing-phase condition: Np·(initP − β) + Nc·(initC − β − π) ≡ π (mod 2π)
    g.init = g.beta + Math.PI + (Math.PI - p.teeth * (p.init - g.beta)) / g.teeth;
  });

  const gearSystem = new THREE.Group();
  const gearGroups = gearDefs.map((def) => {
    const g = makeGear(def.teeth, def.r, 0.26);
    g.position.set(def.x, def.y, 0);
    g.rotation.z = def.init;
    gearSystem.add(g);
    return g;
  });

  gearSystem.position.set(2.3, -0.35, 0); // shift to the right side of the hero
  scene.add(gearSystem);

  scene.add(new THREE.AmbientLight(0xffffff, 0.18));

  const light1 = new THREE.PointLight(0x00d4ff, 10, 26);
  light1.position.set(5, 3, 4);
  scene.add(light1);

  const light2 = new THREE.PointLight(0x0044cc, 5, 18);
  light2.position.set(-2, -3, 3);
  scene.add(light2);

  // Mouse → tilt the whole gear train
  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;

  window.addEventListener('mousemove', (e) => {
    targetX = (e.clientX / W - 0.5) * 1.0;
    targetY = (e.clientY / H - 0.5) * 0.7;
  }, { passive: true });

  // Scroll → progressively spin the gears faster
  let scrollSpeed = 1;
  ScrollTrigger.create({
    trigger: '#hero',
    start: 'top top',
    end: 'bottom top',
    onUpdate: (self) => { scrollSpeed = 1 + self.progress * 5; },
  });

  let baseAngle = 0;
  function animate() {
    requestAnimationFrame(animate);

    baseAngle += 0.007 * scrollSpeed;
    gearGroups.forEach((g, i) => {
      g.rotation.z = gearDefs[i].init + baseAngle * gearDefs[i].ratio;
    });

    currentX += (targetX - currentX) * 0.04;
    currentY += (targetY - currentY) * 0.04;
    gearSystem.rotation.y = currentX * 0.5;
    gearSystem.rotation.x = -currentY * 0.35;

    renderer.render(scene, camera);
  }
  animate();

  gsap.to(wrapper, {
    opacity: 0,
    scrollTrigger: {
      trigger: '#hero',
      start: '50% top',
      end: '90% top',
      scrub: 1,
    },
  });

  window.addEventListener('resize', () => {
    W = window.innerWidth;
    H = window.innerHeight;
    camera.aspect = W / H;
    camera.updateProjectionMatrix();
    renderer.setSize(W, H);
    ScrollTrigger.refresh();
  });

  const nav      = document.getElementById('main-nav') as HTMLElement;
  const progress = nav.querySelector('.nav-progress') as HTMLElement;

  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 60);
    const total = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = ((window.scrollY / total) * 100) + '%';
  }, { passive: true });

  const cursor   = document.getElementById('cursor') as HTMLElement;
  const follower = document.getElementById('cursor-follower') as HTMLElement;

  const moveX   = gsap.quickTo(cursor,   'x', { duration: 0.08 });
  const moveY   = gsap.quickTo(cursor,   'y', { duration: 0.08 });
  const followX = gsap.quickTo(follower, 'x', { duration: 0.38, ease: 'power3' });
  const followY = gsap.quickTo(follower, 'y', { duration: 0.38, ease: 'power3' });

  window.addEventListener('mousemove', (e) => {
    moveX(e.clientX); moveY(e.clientY);
    followX(e.clientX); followY(e.clientY);
  }, { passive: true });

  document.querySelectorAll<HTMLElement>('a, button').forEach(el => {
    el.addEventListener('mouseenter', () =>
      gsap.to(follower, { scale: 2.2, opacity: 0.18, duration: 0.3 }));
    el.addEventListener('mouseleave', () =>
      gsap.to(follower, { scale: 1, opacity: 0.45, duration: 0.3 }));
  });

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    gsap.set(wrapper,                   { opacity: 0 });
    gsap.set('#main-nav',               { opacity: 0, y: -24 });
    gsap.set('.hero-eyebrow',           { opacity: 0 });
    gsap.set('.hero-subtitle',          { opacity: 0, y: 18 });
    gsap.set('.hero-tags',              { opacity: 0, y: 16 });
    gsap.set('.hero-ctas',              { opacity: 0, y: 16 });
    gsap.set('.scroll-indicator',       { opacity: 0 });

    const split = new SplitText('.hero-name', { type: 'chars' });
    gsap.set(split.chars, { opacity: 0, y: 70, rotationX: -85, transformOrigin: '50% 50% -30px' });

    const tl = gsap.timeline({ delay: 0.25 });

    tl.to(wrapper, { opacity: 1, duration: 1.6, ease: 'power2.out' });

    tl.to(split.chars, {
      opacity: 1,
      y: 0,
      rotationX: 0,
      stagger: 0.038,
      duration: 0.72,
      ease: 'back.out(1.8)',
    }, '-=1.0');

    tl.to('.hero-eyebrow',     { opacity: 1, duration: 0.5, ease: 'power3.out' }, '-=0.5');
    tl.to('.hero-subtitle',    { opacity: 1, y: 0, duration: 0.65, ease: 'power3.out' }, '-=0.35');
    tl.to('.hero-tags',        { opacity: 1, y: 0, duration: 0.6,  ease: 'power3.out' }, '-=0.45');
    tl.to('.hero-ctas',        { opacity: 1, y: 0, duration: 0.6,  ease: 'power3.out' }, '-=0.45');
    tl.to('.scroll-indicator', { opacity: 1, duration: 0.6 }, '-=0.2');
    tl.to('#main-nav',         { opacity: 1, y: 0, duration: 0.55, ease: 'power3.out' }, '<-1.2');
  }

  const revealObserver = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        revealObserver.unobserve(e.target);
      }
    }),
    { threshold: 0.14 }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
</script>
