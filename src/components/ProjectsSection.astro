---
import { projects } from '../data/projects.js';
import { useTranslations, normalizeLocale, pickLocalized } from '../i18n/utils.js';

const locale = normalizeLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section id="projetos" class="projects-section">
  <div class="container">
    <p class="section-label reveal">{t('projects.label')}</p>
    <h2 class="section-heading reveal" set:html={t('projects.headingHtml')} />
  </div>

  <div class="projects-list">
    {projects.map((project, i) => (
      <article class={`project-card reveal reveal-delay-${Math.min(i, 3)}`} data-id={project.id}>
        <div class="card-inner container">
          <div class="card-left">
            <span class="project-num" aria-hidden="true">{project.num}</span>
            <div class="project-icon" aria-hidden="true">
              <img src={project.icon} alt="" width="72" height="72" loading="lazy" decoding="async" />
            </div>
            <div class="project-meta">
              <h3 class="project-name">{project.name}</h3>
              <p class="project-tagline">{pickLocalized(project.tagline, locale)}</p>
              <p class="project-desc">{pickLocalized(project.description, locale)}</p>
            </div>
          </div>

          <div class="card-right">
            <span class="project-type">{pickLocalized(project.type, locale)}</span>
            {project.playStore && (
              <span class="project-store" title={t('projects.playStoreTitle')}>
                <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M3.6 1.9a1.3 1.3 0 0 0-.5 1v18.2a1.3 1.3 0 0 0 .5 1l.1.1 10.2-10.1v-.2L3.7 1.8l-.1.1Zm13.5 6.6-2.6 2.6v.2l2.6 2.6.1-.1 3.1-1.7c.9-.5.9-1.4 0-1.9l-3.2-1.7ZM14.3 11l-9.8 9.8c.3.3.8.3 1.3 0l11.6-6.5L14.3 11Zm0 2L4.5 3.2c-.5-.3-1-.3-1.3 0l11.6 6.5L17.4 8l-3.1 5Z"
                  />
                </svg>
                {t('projects.playStore')}
              </span>
            )}
            <div class="project-stack">
              {project.stack.map(tech => (
                <span class="stack-tag">{tech}</span>
              ))}
            </div>
            {project.link ? (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-link">
                {t('projects.view')} <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="project-link-wip">{t('projects.wip')}</span>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-section {
    padding: var(--section-pad) 0;
    background: var(--bg);
  }

  .projects-section > .container {
    margin-bottom: 3rem;
  }

  .heading-accent { color: var(--accent); }

  /* ─── Project list ─── */
  .projects-list {
    display: flex;
    flex-direction: column;
  }

  .project-card {
    border-top: 1px solid var(--border);
    transition: background 0.4s;
    cursor: default;
  }
  .project-card:last-child {
    border-bottom: 1px solid var(--border);
  }

  .card-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: center;
    padding: 3.5rem 0;
    transition: padding 0.3s;
  }

  .project-card:hover {
    background: rgba(0, 212, 255, 0.018);
  }
  .project-card:hover .card-inner {
    padding-left: 1.5rem;
  }

  /* Left side */
  .card-left {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .project-icon {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.06);
    transition: border-color 0.3s, transform 0.3s;
  }
  .project-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.88;
    transition: opacity 0.3s;
  }
  .project-card:hover .project-icon {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }
  .project-card:hover .project-icon img { opacity: 1; }

  .project-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1;
    color: var(--text-dim);
    flex-shrink: 0;
    transition: color 0.3s;
    user-select: none;
  }
  .project-card:hover .project-num { color: var(--accent-glow); }

  .project-meta { flex: 1; }

  .project-name {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
    transition: color 0.3s;
  }
  .project-card:hover .project-name { color: var(--accent); }

  .project-tagline {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .project-desc {
    font-size: 0.93rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 52ch;
  }

  /* Right side */
  .card-right {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .project-type {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .project-store {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.3rem 0.7rem;
    margin-top: -0.4rem;
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: 2rem;
    background: var(--accent-dim);
  }
  .project-store svg { flex-shrink: 0; }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .stack-tag {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
    color: var(--text-muted);
    background: rgba(255,255,255,0.02);
    transition: border-color 0.3s, color 0.3s;
  }
  .project-card:hover .stack-tag {
    border-color: rgba(0, 212, 255, 0.2);
  }

  .project-link {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--accent);
    transition: gap 0.3s, opacity 0.3s;
  }
  .project-link:hover { gap: 0.7rem; opacity: 0.75; }

  .project-link-wip {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
  }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .card-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .card-right { padding-left: calc(3rem + 72px + 3.5rem); }
  }

  @media (max-width: 600px) {
    .card-left { gap: 1rem; }
    .card-right { padding-left: 0; }
    .project-num { font-size: 2.5rem; }
    .project-icon { width: 54px; height: 54px; border-radius: 12px; }
    .project-card:hover .card-inner { padding-left: 0; }
  }
</style>
