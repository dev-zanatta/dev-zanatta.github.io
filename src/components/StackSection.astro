---
import { useTranslations, normalizeLocale } from '../i18n/utils.js';

const locale = normalizeLocale(Astro.currentLocale);
const t = useTranslations(locale);

const groups = [
  {
    category: t('stack.catFrontend'),
    items: ['Vue.js', 'Quasar', 'Inertia', 'Astro', 'JavaScript', 'HTML5', 'CSS3'],
  },
  {
    category: t('stack.catBackend'),
    items: ['Laravel', 'PHP', 'Node.js', 'REST API', t('stack.queues'), 'Redis'],
  },
  {
    category: t('stack.catDb'),
    items: ['PostgreSQL', 'MySQL', 'AWS', 'S3', 'EC2', { name: 'Docker', learning: true }, 'Git'],
  },
  {
    category: t('stack.catPlatforms'),
    items: ['Capacitor', 'Tauri', 'Android', 'PWA/SPA'],
  },
];

const studying = [
  { name: 'React', desc: t('stack.studyReactDesc') },
  { name: 'C# / .NET', desc: t('stack.studyCsharpDesc') },
  { name: 'Docker', desc: t('stack.studyDockerDesc') },
];
---

<section id="stack" class="stack-section">
  <div class="container">
    <p class="section-label reveal">{t('stack.label')}</p>
    <h2 class="section-heading reveal" set:html={t('stack.headingHtml')} />

    <div class="stack-grid">
      {groups.map((group, gi) => (
        <div class={`stack-group reveal reveal-delay-${gi}`}>
          <h3 class="group-label">{group.category}</h3>
          <div class="group-items">
            {group.items.map(item => (
              typeof item === 'string' ? (
                <span class="tech-pill">{item}</span>
              ) : (
                <span class="tech-pill tech-pill-learning">
                  {item.name}
                  <span class="pill-tag">{t('stack.learningTag')}</span>
                </span>
              )
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="study-block">
      <p class="section-label reveal">{t('stack.studyLabel')}</p>
      <h2 class="section-heading reveal" set:html={t('stack.studyHeading')} />
      <p class="study-intro reveal reveal-delay-1">{t('stack.studyIntro')}</p>

      <div class="study-grid">
        {studying.map((item, si) => (
          <article class={`study-card reveal reveal-delay-${si + 1}`}>
            <div class="study-head">
              <h3 class="study-name">{item.name}</h3>
              <span class="study-badge">{t('stack.learningTag')}</span>
            </div>
            <p class="study-desc">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .stack-section {
    padding: var(--section-pad) 0;
    background: var(--bg-2);
    position: relative;
  }

  .stack-section::before,
  .stack-section::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: min(1160px, 90vw);
    height: 1px;
    background: var(--border);
  }
  .stack-section::before { top: 0; }
  .stack-section::after  { bottom: 0; }

  .heading-accent {
    color: var(--accent);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 3rem;
  }

  .stack-group {
    padding: 2rem 2rem 2.5rem;
    border-right: 1px solid var(--border);
    transition: background 0.3s;
  }
  .stack-group:last-child { border-right: none; }
  .stack-group:hover { background: rgba(0, 212, 255, 0.025); }

  .group-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .group-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-pill {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 2rem;
    color: var(--text-muted);
    background: rgba(255,255,255,0.02);
    transition: color 0.3s, border-color 0.3s, background 0.3s, transform 0.2s;
    cursor: default;
  }
  .tech-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-dim);
    transform: translateY(-1px);
  }

  .tech-pill-learning {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-style: dashed;
  }
  .pill-tag {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
  }

  .study-block {
    margin-top: clamp(4rem, 8vw, 6.5rem);
    padding-top: clamp(3rem, 5vw, 4rem);
    border-top: 1px solid var(--border);
  }

  .study-intro {
    max-width: 62ch;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.7;
  }

  .study-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .study-card {
    padding: 1.75rem 1.75rem 2rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.015);
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
  }
  .study-card:hover {
    border-color: var(--border-hover);
    background: var(--accent-dim);
    transform: translateY(-2px);
  }

  .study-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .study-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .study-badge {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.25rem 0.6rem;
    border: 1px dashed rgba(0, 212, 255, 0.35);
    border-radius: 2rem;
  }

  .study-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  @media (max-width: 1000px) {
    .stack-grid { grid-template-columns: repeat(2, 1fr); }
    .study-grid { grid-template-columns: 1fr; }
    .stack-group:nth-child(2)  { border-right: none; }
    .stack-group:nth-child(1),
    .stack-group:nth-child(2) {
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 600px) {
    .stack-grid { grid-template-columns: 1fr; }
    .stack-group { border-right: none; border-bottom: 1px solid var(--border); }
    .stack-group:last-child { border-bottom: none; }
  }
</style>
