---
import { useTranslations, normalizeLocale } from '../i18n/utils.js';

const locale = normalizeLocale(Astro.currentLocale);
const t = useTranslations(locale);

const socials = [
  { label: 'GitHub',   href: 'https://github.com/dev-zanatta' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/gzanatta/' },
];

const year = new Date().getFullYear();
---

<section id="contato" class="contact-section">
  <div class="container">
    <div class="contact-inner">
      <p class="section-label reveal">{t('contact.label')}</p>

      <h2 class="contact-heading reveal" set:html={t('contact.headingHtml')} />

      <p class="contact-body reveal reveal-delay-1">
        {t('contact.body')}
      </p>

      <a
        href="mailto:gustavozanatta.dev@gmail.com"
        class="contact-email reveal reveal-delay-2"
        aria-label={t('contact.emailAria')}
      >
        gustavozanatta.dev@gmail.com
      </a>

      <div class="social-row reveal reveal-delay-3">
        {socials.map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="social-link">
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="contact-glow" aria-hidden="true"></div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="footer-copy">
      © {year} Gustavo Felipe Zanatta
    </span>
    <span class="footer-built">
      {t('footer.built')}
    </span>
  </div>
</footer>

<style>
  .contact-section {
    padding: var(--section-pad) 0 calc(var(--section-pad) * 0.7);
    background: var(--bg-2);
    position: relative;
    overflow: hidden;
  }
  .contact-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1160px, 90vw);
    height: 1px;
    background: var(--border);
  }

  .contact-glow {
    position: absolute;
    bottom: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse at center, var(--accent-glow) 0%, transparent 70%);
    pointer-events: none;
    opacity: 0.35;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .heading-accent { color: var(--accent); }

  .contact-heading {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: 0.01em;
    color: var(--text);
    margin-bottom: 1.75rem;
  }

  .contact-body {
    color: var(--text-muted);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    max-width: 46ch;
    margin-bottom: 2.5rem;
  }

  .contact-email {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 500;
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2rem;
    margin-bottom: 2.5rem;
    transition: color 0.3s, border-color 0.3s;
  }
  .contact-email:hover {
    color: var(--accent);
  }

  .social-row {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .social-link {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    position: relative;
    transition: color 0.3s;
  }
  .social-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease);
  }
  .social-link:hover { color: var(--text); }
  .social-link:hover::after { width: 100%; }

  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-copy,
  .footer-built {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
