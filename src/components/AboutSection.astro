---
import { useTranslations, normalizeLocale } from '../i18n/utils.js';

const locale = normalizeLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section id="sobre" class="about-section">
  <div class="container">
    <div class="about-grid">

      <div class="about-text">
        <p class="section-label reveal">{t('about.label')}</p>
        <h2 class="section-heading reveal" set:html={t('about.headingHtml')} />
        <div class="about-body">
          <p class="reveal reveal-delay-1" set:html={t('about.p1Html')} />
          <p class="reveal reveal-delay-2" set:html={t('about.p2Html')} />
        </div>
      </div>

      <div class="about-stats">
        <div class="stat-item reveal">
          <span class="stat-number">3<span class="stat-plus">+</span></span>
          <span class="stat-label">{t('about.statYears')}</span>
        </div>
        <div class="stat-item reveal reveal-delay-1">
          <span class="stat-number">9</span>
          <span class="stat-label">{t('about.statProjects')}</span>
        </div>
        <div class="stat-item reveal reveal-delay-2">
          <span class="stat-number">{t('about.statPlatform')}</span>
          <span class="stat-label">{t('about.statPlatformSub')}</span>
        </div>

        <div class="about-highlight reveal reveal-delay-4">
          <span class="highlight-icon">→</span>
          <span>{t('about.highlight')}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .about-section {
    padding: var(--section-pad) 0;
    background: var(--bg);
  }

  .about-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1160px, 90vw);
    height: 1px;
    background: var(--border);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 6vw, 7rem);
    align-items: start;
  }

  .section-heading {
    margin-bottom: 2rem;
  }
  .heading-accent {
    color: var(--accent);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
  }

  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 4.5rem;
  }

  .stat-item {
    padding: 1.75rem 2rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: rgba(255,255,255,0.015);
    transition: border-color 0.3s, background 0.3s;
    margin-bottom: 0.5rem;
  }
  .stat-item:hover {
    border-color: var(--border-hover);
    background: var(--accent-dim);
  }

  .stat-number {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 4rem);
    line-height: 1;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  .stat-plus {
    font-size: 0.55em;
    vertical-align: super;
  }
  .stat-label {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .about-highlight {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: 0.88rem;
  }
  .highlight-icon {
    color: var(--accent);
    font-size: 1rem;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .about-stats { padding-top: 0; }
  }
</style>
