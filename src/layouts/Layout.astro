---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import { useTranslations, normalizeLocale } from '../i18n/utils.js';

interface Props {
  title?: string;
  description?: string;
  /** Caminho da página em cada idioma (hreflang/canonical). Padrão: a home. */
  paths?: { pt: string; en: string; es: string };
  ogImage?: string;
  ogType?: string;
}

const locale = normalizeLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  title = t('meta.title'),
  description = t('meta.description'),
  paths = { pt: '/', en: '/en/', es: '/es/' },
  ogImage,
  ogType = 'website',
} = Astro.props;

const htmlLang = locale === 'pt' ? 'pt-BR' : locale;
const ogLocale = { pt: 'pt_BR', en: 'en_US', es: 'es_ES' }[locale];

const site = Astro.site ?? new URL('https://zntt.dev.br');
const alternates = [
  { hreflang: 'pt-BR',     href: new URL(paths.pt, site).href },
  { hreflang: 'en',        href: new URL(paths.en, site).href },
  { hreflang: 'es',        href: new URL(paths.es, site).href },
  { hreflang: 'x-default', href: new URL(paths.pt, site).href },
];
const canonical = new URL(paths[locale], site).href;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080808" />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    {alternates.map(alt => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <meta property="og:type" content={ogType} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />

    <script is:inline>
      // Primeira visita à raiz sem preferência salva: redireciona pelo idioma do navegador.
      // Ao clicar numa bandeira a escolha é salva e este redirect nunca mais roda.
      (function () {
        try {
          if (localStorage.getItem('preferred-lang')) return;
          var p = window.location.pathname;
          if (p !== '/' && p !== '/index.html') return;
          var lang = (navigator.language || '').toLowerCase();
          if (lang.indexOf('en') === 0) window.location.replace('/en/');
          else if (lang.indexOf('es') === 0) window.location.replace('/es/');
        } catch (e) { /* sem storage, segue em pt */ }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Cursor />
    <slot />
  </body>
</html>
